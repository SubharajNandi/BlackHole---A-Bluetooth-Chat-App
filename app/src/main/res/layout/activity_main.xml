<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/activity_main_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/not_connected"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:padding="12dp" />

    <ListView
        android:id="@+id/list_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginTop="8dp">

        <!-- iOS Glassmorphism Scan Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_scan"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_ios_glass_button"
            android:text="@string/scan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Modern Pill Chat Input Box -->
        <EditText
            android:id="@+id/edit_text_message"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chat_input"
            android:hint="@string/message_hint"
            android:textColorHint="#99FFFFFF"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:gravity="center_vertical" />

        <!-- WhatsApp Style Circular Green Send Button -->
        <ImageButton
            android:id="@+id/button_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_whatsapp_send"
            android:src="@drawable/ic_send_paper_plane"
            android:scaleType="centerInside"
            android:contentDescription="@string/send"
            android:enabled="false"
            android:elevation="4dp" />

    </LinearLayout>

</LinearLayout>